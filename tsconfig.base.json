{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@blackshop/vsl-hosting": ["packages/vsl-hosting/src/index.ts"],
      "@blackshop/vsl-hosting/*": ["packages/vsl-hosting/src/*"],
      "@blackshop/db": ["packages/db/src/index.ts"],
      "@blackshop/db/*": ["packages/db/src/*"],
      "@blackshop/shared": ["packages/shared/src/index.ts"],
      "@blackshop/shared/*": ["packages/shared/src/*"],
      "@blackshop/importer": ["packages/importer/src/index.ts"],
      "@blackshop/importer/*": ["packages/importer/src/*"],
      "@blackshop/whitelabel": ["packages/whitelabel/src/index.ts"],
      "@blackshop/whitelabel/*": ["packages/whitelabel/src/*"],
      "@blackshop/shopify-adapter": ["packages/shopify-adapter/src/index.ts"],
      "@blackshop/shopify-adapter/*": ["packages/shopify-adapter/src/*"],
      "@blackshop/vault": ["packages/vault/src/index.ts"],
      "@blackshop/vault/*": ["packages/vault/src/*"],
      "@blackshop/pricing": ["packages/pricing/src/index.ts"],
      "@blackshop/pricing/*": ["packages/pricing/src/*"],
      "@blackshop/payments": ["packages/payments/src/index.ts"],
      "@blackshop/payments/*": ["packages/payments/src/*"],
      "@blackshop/storefront-engine": ["packages/storefront-engine/src/index.ts"],
      "@blackshop/storefront-engine/*": ["packages/storefront-engine/src/*"],
      "@blackshop/cart": ["packages/cart/src/index.ts"],
      "@blackshop/cart/*": ["packages/cart/src/*"],
      "@blackshop/shopify-storefront": ["packages/shopify-storefront/src/index.ts"],
      "@blackshop/shopify-storefront/*": ["packages/shopify-storefront/src/*"],
      "@blackshop/tracking": ["packages/tracking/src/index.ts"],
      "@blackshop/tracking/*": ["packages/tracking/src/*"],
      "@blackshop/trustshield": ["packages/trustshield/src/index.ts"],
      "@blackshop/trustshield/*": ["packages/trustshield/src/*"],
      "@blackshop/landinglab-render": ["packages/landinglab-render/src/index.ts"],
      "@blackshop/landinglab-render/*": ["packages/landinglab-render/src/*"],
      "@blackshop/landinglab-domains": ["packages/landinglab-domains/src/index.ts"],
      "@blackshop/landinglab-domains/*": ["packages/landinglab-domains/src/*"],
      "@blackshop/landinglab-research": ["packages/landinglab-research/src/index.ts"],
      "@blackshop/landinglab-research/*": ["packages/landinglab-research/src/*"],
      "@blackshop/landinglab-copy": ["packages/landinglab-copy/src/index.ts"],
      "@blackshop/landinglab-copy/*": ["packages/landinglab-copy/src/*"],
      "@blackshop/landinglab-visual": ["packages/landinglab-visual/src/index.ts"],
      "@blackshop/landinglab-visual/*": ["packages/landinglab-visual/src/*"],
      "@blackshop/landinglab-build": ["packages/landinglab-build/src/index.ts"],
      "@blackshop/landinglab-build/*": ["packages/landinglab-build/src/*"],
      "@blackshop/landinglab-deploy": ["packages/landinglab-deploy/src/index.ts"],
      "@blackshop/landinglab-deploy/*": ["packages/landinglab-deploy/src/*"],
      "@blackshop/tracker-engine": ["packages/tracker-engine/src/index.ts"],
      "@blackshop/tracker-engine/*": ["packages/tracker-engine/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
