    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "preact": "^11.1.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
