{
  "name": "@blackshop/backoffice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv --no-expand -e ../../.env -e ../../.env.local -- next dev -p 3000",
    "prebuild": "pnpm --filter @blackshop/landinglab-render build && pnpm --filter @blackshop/landinglab-cloner build && pnpm --filter @blackshop/landinglab-build build:html-builder",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ./vitest.config.ts --passWithNoTests",
    "lint": "next lint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@blackshop/db": "workspace:*",
    "@blackshop/errors": "workspace:*",
    "@blackshop/landinglab-adapters": "workspace:*",
    "@blackshop/landinglab-build": "workspace:*",
    "@blackshop/landinglab-cloner": "workspace:*",
    "@blackshop/landinglab-deploy": "workspace:*",
    "@blackshop/landinglab-domains": "workspace:*",
    "@blackshop/landinglab-render": "workspace:*",
    "@blackshop/landinglab-visual": "workspace:*",
    "@blackshop/payments": "workspace:*",
    "@blackshop/pricing": "workspace:*",
    "@blackshop/shared": "workspace:*",
    "@blackshop/shopify-adapter": "workspace:*",
    "@blackshop/vault": "workspace:*",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@supabase/supabase-js": "^2.108.0",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@types/dompurify": "^3.2.0",
    "bullmq": "^5.21.0",
    "cheerio": "^1.2.0",
    "cobe": "2.0.1",
    "dompurify": "^3.4.11",
    "drizzle-orm": "^0.36.4",
    "ioredis": "^5.4.1",
    "lucide-react": "^1.17.0",
    "next": "^14.2.15",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tus-js-client": "4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
