{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile"
  },
  "deploy": {
    "startCommand": "pnpm --filter @blackshop/api exec tsx src/index.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "watchPatterns": [
    "apps/api/**",
    "packages/db/**",
    "packages/email/**",
    "packages/errors/**",
    "packages/factory/**",
    "packages/importer/**",
    "packages/jobs/**",
    "packages/observability/**",
    "packages/landinglab-cloner/**",
    "packages/landinglab-deploy/**",
    "packages/landinglab-domains/**",
    "packages/landinglab-render/**",
    "packages/payments/**",
    "packages/pricing/**",
    "packages/shared/**",
    "packages/shopify-adapter/**",
    "packages/shopify-storefront/**",
    "packages/storefront-engine/**",
    "packages/tracker-engine/**",
    "packages/tracking/**",
    "packages/trustshield/**",
    "packages/vault/**",
    "packages/vsl-hosting/**",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ]
}
