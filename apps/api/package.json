{
  "name": "@blackshop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "dotenv --no-expand -e ../../.env -e ../../.env.local -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "create-owner": "dotenv --no-expand -e ../../.env -- tsx scripts/create-owner.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.100.1",
    "@blackshop/db": "workspace:*",
    "@blackshop/errors": "workspace:*",
    "@blackshop/jobs": "workspace:*",
    "@blackshop/observability": "workspace:*",
    "@blackshop/landinglab-cloner": "workspace:*",
    "@blackshop/landinglab-deploy": "workspace:*",
    "@blackshop/payments": "workspace:*",
    "@blackshop/pricing": "workspace:*",
    "@blackshop/shared": "workspace:*",
    "@blackshop/shopify-adapter": "workspace:*",
    "@blackshop/vault": "workspace:*",
    "@blackshop/vsl-hosting": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/session": "^10.9.0",
    "@maxmind/geoip2-node": "^5.0.0",
    "@node-rs/argon2": "2.2.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.29.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.1",
    "isbot": "^5.1.17",
    "openai": "^4.68.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "tsx": "^4.19.2",
    "tus-js-client": "4",
    "ua-parser-js": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.12.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
