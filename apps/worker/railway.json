{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/worker/Dockerfile",
    "dockerContext": "."
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "watchPatterns": [
    "apps/worker/**",
    "packages/**",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ]
}
