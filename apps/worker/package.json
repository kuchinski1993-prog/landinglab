    "@blackshop/landinglab-cloner": "workspace:*",
    "@blackshop/landinglab-copy": "workspace:*",
    "@blackshop/landinglab-deploy": "workspace:*",
    "@blackshop/landinglab-domains": "workspace:*",
    "@blackshop/landinglab-research": "workspace:*",
    "@blackshop/landinglab-visual": "workspace:*",
    "@blackshop/pricing": "workspace:*",
    "@blackshop/shared": "workspace:*",
    "@blackshop/shopify-adapter": "workspace:*",
    "@blackshop/vault": "workspace:*",
    "@supabase/supabase-js": "^2.108.0",
    "bullmq": "^5.21.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.36.4",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
