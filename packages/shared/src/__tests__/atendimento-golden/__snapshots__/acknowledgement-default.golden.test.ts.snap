exports[`golden default · renderAcknowledgement > com policyUrl/portalUrl e caracteres que exigem escape no HTML 1`] = `
{
  "htmlBody": "<!DOCTYPE html>
<html lang="en-GB">
<head><meta charset="UTF-8"><meta name="color-scheme" content="light dark"></head>
<body style="margin:0;padding:0;background:#f6f6f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1a1a1a;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f7;padding:32px 16px;">
  <tr><td align="center">
    <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;">
      <tr><td style="padding:32px;"><p style="font-size:15px;line-height:1.55;color:#3b3d40;margin:0 0 12px 0;">Hello O&#39;Brien &lt;b&gt;,</p><p style="font-size:15px;line-height:1.55;color:#3b3d40;margin:0 0 12px 0;">Thank you for getting in touch about order #7&amp;8. We&#39;ve received your message and our team will review it and get back to you within 1 business day (Monday to Friday, 9am–6pm GMT).</p><p style="font-size:15px;line-height:1.55;color:#3b3d40;margin:0 0 12px 0;">Your refund request has been recorded and will be reviewed by a member of our team. Refund decisions are made individually — we&#39;ll confirm the outcome in a follow-up email within 1 business day.</p><p style="font-size:15px;line-height:1.55;color:#3b3d40;margin:0 0 12px 0;">Our returns and refunds policy is available here: https://authenlondon.com/policies/refund-policy</p><p style="font-size:15px;line-height:1.55;color:#3b3d40;margin:0 0 12px 0;">You can also track this request in our support portal: https://authenlondon.com/support</p><p style="font-size:15px;line-height:1.55;color:#3b3d40;margin:0 0 12px 0;">Kind regards,<br>The AuthenLondon team</p></td></tr>
      <tr><td style="padding:0 32px 32px 32px;text-align:center;font-size:12px;color:#6d7175;line-height:1.6;">
        <div style="border-top:1px solid #e1e3e5;padding-top:16px;">
          Questions? Reply to this email or write to <a href="mailto:support@authenlondon.com" style="color:#6d7175;">support@authenlondon.com</a>.<br>
          Can't find our emails? Check your spam folder and add us to your contacts.<br><br>
          AuthenLondon · 35 Weir Rd, London SW12 0NU, United Kingdom
        </div>
      </td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>",
  "internalNotes": "Deterministic acknowledgement. category=refund_request, verification=verified_match, orderRef=#7&8, policyUrl=set, portalUrl=set",
  "subject": "We've received your message about order #7&8",
  "textBody": "Hello O'Brien <b>,

Thank you for getting in touch about order #7&8. We've received your message and our team will review it and get back to you within 1 business day (Monday to Friday, 9am–6pm GMT).

Your refund request has been recorded and will be reviewed by a member of our team. Refund decisions are made individually — we'll confirm the outcome in a follow-up email within 1 business day.

Our returns and refunds policy is available here: https://authenlondon.com/policies/refund-policy

You can also track this request in our support portal: https://authenlondon.com/support

Kind regards,
The AuthenLondon team",
}
`;

