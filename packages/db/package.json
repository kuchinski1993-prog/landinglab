{
  "name": "@blackshop/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./schema-landinglab": "./src/schema-landinglab.ts",
    "./schema-landinglab-core": "./src/schema-landinglab-core.ts",
    "./schema-skeleton-mode": "./src/schema-skeleton-mode.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:check": "tsx src/check-drift.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv --no-expand -e ../../.env -- tsx src/migrate.ts",
    "db:studio": "dotenv --no-expand -e ../../.env -- drizzle-kit studio",
    "db:push": "dotenv --no-expand -e ../../.env -- drizzle-kit push",
    "db:seed": "dotenv --no-expand -e ../../.env -- node scripts/seed-landing.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
