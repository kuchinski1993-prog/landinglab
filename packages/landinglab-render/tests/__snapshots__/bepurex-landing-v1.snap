<div lang="en-GB" data-skeleton-id="bepurex-landing-v1"><style>:root{--color-primary:#0a5f3a;--color-secondary:#f4a300;--color-accent:#c8322f;--color-bg:#fdfaf3;--color-text:#111111;--font-headline:'Playfair Display',sans-serif;--font-body:'Inter',sans-serif}body{margin:0;font-family:var(--font-body);color:var(--color-text);background:var(--color-bg);line-height:1.5;padding-bottom:80px}h1,h2,h3,h4{font-family:var(--font-headline);color:var(--color-text);line-height:1.15;margin:0 0 0.5em}h1{font-size:clamp(2rem,5vw,3.5rem)}h2{font-size:clamp(1.5rem,3.5vw,2.25rem)}h3{font-size:clamp(1.15rem,2.5vw,1.5rem)}p{margin:0 0 1em}img{max-width:100%;height:auto;display:block}a{color:var(--color-primary)}.ll-container{max-width:960px;margin:0 auto;padding:0 1rem}.ll-section{padding:3.5rem 0}.ll-cta{display:inline-block;background:var(--color-primary);color:#fff;padding:1rem 2rem;border-radius:8px;font-weight:700;text-decoration:none;font-size:1.125rem;border:0;cursor:pointer}.ll-cta--secondary{background:transparent;color:var(--color-primary);border:2px solid var(--color-primary)}.ll-cta--tertiary{background:var(--color-secondary)}.ll-hero{background:linear-gradient(180deg,var(--color-bg) 0%,rgba(0,0,0,0.03) 100%);padding:3.5rem 0}.ll-hero__grid{display:grid;grid-template-columns:1fr;gap:2rem;align-items:center}@media (min-width:768px){.ll-hero__grid{grid-template-columns:1.1fr 1fr}}.ll-hero__image{border-radius:12px;overflow:hidden}.ll-bullets{list-style:none;padding:0;margin:0;display:grid;gap:1rem}.ll-bullet{display:grid;grid-template-columns:auto 1fr;gap:0.75rem;align-items:start;padding:0.75rem 0}.ll-bullet__icon{width:2rem;height:2rem}.ll-bullet__dot{width:0.75rem;height:0.75rem;background:var(--color-accent);border-radius:999px;margin-top:0.5rem}.ll-offer{background:var(--color-bg);border:2px solid var(--color-primary);border-radius:12px;padding:2rem;text-align:center;box-shadow:0 4px 20px rgba(0,0,0,0.08)}.ll-offer__price{font-size:2.5rem;font-weight:800;color:var(--color-primary);margin:1rem 0 0.25rem}.ll-offer__value{text-decoration:line-through;color:#888;font-size:1.125rem}.ll-offer__savings{color:var(--color-accent);font-weight:700;margin:0.25rem 0 1.25rem}.ll-guarantee{border:3px dashed var(--color-secondary);padding:2rem;border-radius:12px;background:#fff;text-align:center}.ll-urgency{background:var(--color-secondary);color:#fff;padding:2rem;border-radius:12px;text-align:center}.ll-urgency h2{color:#fff}.ll-testimonial{padding:1.5rem;background:#fff;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.05);border-left:4px solid var(--color-accent);margin-bottom:1rem}.ll-testimonial__source{font-size:0.875rem;color:#666;margin-top:0.5rem}.ll-badges{display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;align-items:center;padding:1rem 0}.ll-badges img{max-height:64px;width:auto}.ll-faq details{border-bottom:1px solid #ddd;padding:1rem 0}.ll-faq summary{cursor:pointer;font-weight:700;font-family:var(--font-headline);font-size:1.125rem}.ll-comparison{border-collapse:collapse;width:100%}.ll-comparison th,.ll-comparison td{padding:0.75rem;border:1px solid #ddd;text-align:left}.ll-comparison th{background:var(--color-primary);color:#fff}.ll-story p{font-size:1.125rem;line-height:1.7;margin-bottom:1.25rem}.ll-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1rem;text-align:center}.ll-stat__value{font-size:2rem;font-weight:800;color:var(--color-primary);display:block}.ll-cta-block{text-align:center;padding:2rem 0}.ll-ba{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1.5rem}@media (max-width:640px){.ll-ba{grid-template-columns:1fr}}.ll-ba__side{margin:0;position:relative}.ll-ba__side img{border-radius:12px;width:100%;aspect-ratio:1/1;object-fit:cover}.ll-ba__label{position:absolute;top:1rem;left:1rem;padding:0.35rem 0.75rem;border-radius:999px;font-weight:700;font-size:0.875rem;color:#fff}.ll-ba__label--before{background:#666}.ll-ba__label--after{background:var(--color-primary)}.ll-benefits{list-style:none;padding:0;margin:2rem 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.5rem}.ll-benefit{display:flex;flex-direction:column;align-items:center;text-align:center;padding:1.5rem;background:#fff;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,0.05)}.ll-benefit img{width:64px;height:64px;margin-bottom:0.75rem}.ll-benefit__num{display:flex;align-items:center;justify-content:center;width:48px;height:48px;background:var(--color-primary);color:#fff;border-radius:50%;font-weight:800;font-size:1.25rem;margin-bottom:0.75rem}.ll-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:0.75rem;margin-top:1.5rem}.ll-gallery__item{aspect-ratio:1/1;overflow:hidden;border-radius:8px;background:rgba(0,0,0,0.03)}.ll-gallery__item img{width:100%;height:100%;object-fit:cover;transition:transform 200ms ease}.ll-gallery__item:hover img{transform:scale(1.05)}.ll-sticky-cta{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid rgba(0,0,0,0.1);box-shadow:0 -4px 16px rgba(0,0,0,0.08);z-index:9999;padding:0.75rem 1rem;padding-bottom:calc(0.75rem + env(safe-area-inset-bottom,0))}.ll-sticky-cta__inner{max-width:960px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:1rem}.ll-sticky-cta__price{font-weight:700;color:var(--color-text);font-size:0.9rem}.ll-sticky-cta__btn{background:var(--color-primary);color:#fff;padding:0.75rem 1.25rem;border-radius:8px;font-weight:700;text-decoration:none;white-space:nowrap;font-size:0.95rem}@media (min-width:768px){.ll-sticky-cta__price{font-size:1rem}.ll-sticky-cta__btn{padding:0.85rem 1.5rem;font-size:1rem}}</style><style>
:root{
