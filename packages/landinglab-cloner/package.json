{
  "name": "@blackshop/landinglab-cloner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./domain-suggester": {
      "types": "./dist/agents/domain-suggester.d.ts",
      "import": "./dist/agents/domain-suggester.js",
      "default": "./dist/agents/domain-suggester.js"
    },
    "./agents/brand-extractor.js": {
      "types": "./dist/agents/brand-extractor.d.ts",
      "import": "./dist/agents/brand-extractor.js",
      "default": "./dist/agents/brand-extractor.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@blackshop/db": "workspace:*",
    "@blackshop/landinglab-render": "workspace:*",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.36.4",
    "parse5": "^7.2.1",
    "playwright": "^1.48.0",
    "sharp": "^0.34.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
